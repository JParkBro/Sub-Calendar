<!--
    Android 11 자동 백업 (minSdk 30). data_extraction_rules.xml과 같은 파일만 백업한다.
-->
<full-backup-content>
    <include domain="database" path="subcal.db" />
    <include domain="database" path="subcal.db-wal" />
    <include domain="database" path="subcal.db-shm" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
