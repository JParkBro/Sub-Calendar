<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 이상 자동 백업 (product-spec 8장, infra.md 2장).
    include가 있으면 적은 파일만 백업한다: Room DB(WAL 파일 포함)와 설정 DataStore.
    WorkManager DB · 캐시 · 그 밖의 파일은 백업하지 않는다 (복원 뒤 첫 실행에서 알림 · 정리 작업을 다시 예약한다).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="subcal.db" />
        <include domain="database" path="subcal.db-wal" />
        <include domain="database" path="subcal.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="subcal.db" />
        <include domain="database" path="subcal.db-wal" />
        <include domain="database" path="subcal.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
